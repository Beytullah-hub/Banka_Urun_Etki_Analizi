<Window x:Class="BankProductImpact.Presentation.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar — Veritabanı Yolu"
        Height="360" Width="640" MinHeight="320" MinWidth="520"
        Background="{StaticResource BgDeepBrush}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E1F30"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource PanelCard}" Margin="16">
        <StackPanel>
            <TextBlock Text="VERİTABANI YOLU" Style="{StaticResource SectionText}"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Ortak (çok kullanıcılı) kullanım için, herkesin eriştiği bir ağ paylaşımındaki tek dosyayı gösterin (ör. \\sunucu\ortak\ProductImpact.db). Değişiklik kaydedildiğinde uygulama yeniden başlatılır."/>

            <TextBlock Text="Şu anki yol" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBlock x:Name="CurrentPathText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Text="Yeni yol" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewPathBox" Grid.Column="0"/>
                <Button Grid.Column="1" Content="Gözat…" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Click="Browse_Click"/>
            </Grid>

            <TextBlock x:Name="FeedbackText" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap"
                       FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                <Button Content="Kaydet ve Yeniden Başlat" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                <Button Content="İptal" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
