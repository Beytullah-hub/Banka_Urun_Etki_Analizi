<Window x:Class="BankProductImpact.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding HeaderTitle}"
        Height="820" Width="1360" MinHeight="640" MinWidth="1100"
        Background="{StaticResource BgDeepBrush}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Karanlık tema için yerel giriş kontrolleri -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E1F30"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== BAŞLIK ===================== -->
        <Grid Grid.Row="0" Margin="4,0,4,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource TitleText}"/>
                    <Border Background="#1B3550" CornerRadius="10" Padding="10,3" Margin="8,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataSourceLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding EditModeStatus}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Ayarlar + Düzenleme modu -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⚙ Ayarlar" Style="{StaticResource GhostButton}" Click="OpenSettings_Click" Margin="0,0,10,0"/>
                <Button Content="{Binding EditModeButtonText}" Command="{Binding ToggleEditModeCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- ===================== GÖVDE ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <!-- ===== SOL PANEL: PARENT SEÇİMİ ===== -->
            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,16,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="BAŞLIK SEÇİMİ" Style="{StaticResource SectionText}"/>
                    <TextBox Grid.Row="1" Margin="0,0,0,10"
                             Text="{Binding ParentSearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- + Yeni Başlık Ekle -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <Button Content="+ Yeni Başlık Ekle" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                Command="{Binding AddParent.OpenCommand}"
                                Visibility="{Binding AddParent.IsOpen, Converter={StaticResource InverseBoolToVis}}"/>

                        <Border Background="#0E1F30" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                Visibility="{Binding AddParent.IsOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Başlık adı (zorunlu)" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding AddParent.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Kısa açıklama" Style="{StaticResource MutedText}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding AddParent.Description, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="Aktif" IsChecked="{Binding AddParent.IsActive}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding AddParent.Feedback}" Foreground="{StaticResource NegativeBrush}"
                                           TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                                           Visibility="{Binding AddParent.HasFeedback, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Command="{Binding AddParent.SaveCommand}"/>
                                    <Button Content="Vazgeç" Style="{StaticResource GhostButton}" Command="{Binding AddParent.CancelCommand}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ListBox Grid.Row="3" ItemsSource="{Binding Parents}" SelectedItem="{Binding SelectedParent}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1C3A56"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#123246"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="13" Margin="0,0,30,0"/>
                                    <Button Content="×" Width="24" Height="24" Padding="0" HorizontalAlignment="Right"
                                            ToolTip="Bu başlığı katalogdan kalıcı olarak sil" Click="DeleteParent_Click"
                                            Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ===== ORTA ALAN: KOKPİT (Repo) / GENERİK AĞAÇ (diğer parent) ===== -->
            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="0,0,16,0" Padding="8">
              <Grid>
                <!-- Parent ağacı: merkez kutu + radyal/konumlu dallar -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding GenericTreeMessage}" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="8,4,8,4"/>

                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Grid Width="960" Height="680">
                            <!-- Sürükle-bırak yüzeyi (tasarım koordinatları) -->
                            <Border x:Name="GenericDropSurface" Background="Transparent" AllowDrop="True" Drop="GenericCanvas_Drop"/>

                            <!-- Dal çizgileri: merkez kutu → her child (child sürüklenince takip eder) -->
                            <ItemsControl ItemsSource="{Binding GenericLines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding Child.CenterX}" Y2="{Binding Child.CenterY}"
                                              Stroke="{StaticResource BranchLineBrush}" StrokeThickness="1.6" SnapsToDevicePixels="True"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Merkez parent kutusu (premium, Repo gibi) -->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="220" Height="130" CornerRadius="18"
                                    Background="#123246" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="#37E0C8" BlurRadius="28" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HeaderTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="16,0,16,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Child dalları (konumlu; sürükle-taşı, × ile çıkar, hover ile bilgi) -->
                            <ItemsControl ItemsSource="{Binding GenericChildNodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="264" Height="96" CornerRadius="16" Background="{StaticResource CardBrush}"
                                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.5"
                                                MouseEnter="Child_MouseEnter" MouseLeave="Child_MouseLeave"
                                                MouseLeftButtonDown="Child_MouseDown"
                                                MouseMove="Child_MouseMove" MouseLeftButtonUp="Child_MouseUp" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Otomatik kategori renk şeridi (kimliğe göre) -->
                                                <Border Grid.Column="0" CornerRadius="16,0,0,16" Background="{Binding AccentBrush}"/>
                                                <Grid Grid.Column="1" Margin="16,12">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="19" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,24,0"/>
                                                    <Button Content="×" Click="RemoveChild_Click" Width="26" Height="26" Padding="0"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Foreground="{StaticResource NegativeBrush}" Background="Transparent" BorderThickness="0"
                                                            FontSize="16" FontWeight="Bold" Cursor="Hand" ToolTip="Ağaçtan çıkar"
                                                            Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>
                </Grid>
              </Grid>
            </Border>

            <!-- ===== SAĞ PANEL ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ===== ÖĞE HAVUZU / DÜZENLEME (düzenleme modu) ===== -->
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14"
                            Visibility="{Binding ChildPool.IsOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="ÖĞE HAVUZU / DÜZENLEME" Style="{StaticResource SectionText}"/>
                            <Button Content="+ Yeni Seçenek Ekle" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Command="{Binding ChildPool.OpenNewNodeFormCommand}" Margin="0,0,0,10"/>

                            <!-- Yeni node formu -->
                            <Border Background="#0E1F30" CornerRadius="10" Padding="12" Margin="0,0,0,12"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    Visibility="{Binding ChildPool.IsNewNodeFormOpen, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Ad (zorunlu)" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ChildPool.NewName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Açıklama" Style="{StaticResource MutedText}" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding ChildPool.NewDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Content="Aktif" IsChecked="{Binding ChildPool.NewIsActive}" Margin="0,8,0,0"/>
                                    <CheckBox Content="Başlık olarak da seçilebilir (soldaki listede görünür)" IsChecked="{Binding ChildPool.NewCanBeRoot}" Margin="0,6,0,0"/>
                                    <CheckBox Content="Seçili başlığa hemen ekle" IsChecked="{Binding ChildPool.NewAddToCurrentParent}" Margin="0,6,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Command="{Binding ChildPool.SaveNewNodeCommand}"/>
                                        <Button Content="İptal" Style="{StaticResource GhostButton}" Command="{Binding ChildPool.CancelNewNodeFormCommand}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBox Text="{Binding ChildPool.SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <CheckBox Content="Yalnızca aktif kayıtlar" IsChecked="{Binding ChildPool.ShowOnlyActive}" Margin="0,0,0,8"/>

                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ChildPool.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,4" Background="Transparent" MouseMove="PoolItem_MouseMove" ToolTip="Sürükleyip grafiğe bırakabilirsiniz">
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,76,0">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="4,0,0,0"/>
                                                    </CheckBox>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#123A2A" CornerRadius="6" Padding="6,1" Margin="0,0,30,0"
                                                            Visibility="{Binding IsBound, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="bağlı" FontSize="10" Foreground="{StaticResource PositiveBrush}"/>
                                                    </Border>
                                                    <Button Content="×" Width="24" Height="24" Padding="0" HorizontalAlignment="Right"
                                                            ToolTip="Bu kaydı katalogdan kalıcı olarak sil" Click="DeletePoolNode_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Button Content="Seçilenleri Ekle" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ChildPool.AddSelectedCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding ChildPool.Feedback}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== NORMAL PANELLER (düzenleme modunda gizli) ===== -->
                    <StackPanel Visibility="{Binding ChildPool.IsOpen, Converter={StaticResource InverseBoolToVis}}">

                    <!-- Öğe bilgi paneli (görüntüleme + düzenleme) -->
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14"
                            Visibility="{Binding IsChildInfoVisible, Converter={StaticResource BoolToVis}}">
                      <StackPanel>
                        <!-- Uyarı: kilit başkasında -->
                        <Border Background="#3A1616" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding HasChildDetailNotice, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ChildDetailNotice}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap" FontSize="12"/>
                        </Border>

                        <!-- ===== GÖRÜNTÜLEME (düzenleme kapalıyken) ===== -->
                        <StackPanel DataContext="{Binding SelectedChildInfo}"
                                    Visibility="{Binding DataContext.IsEditingChildDetails, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                            <Grid>
                                <TextBlock Text="BİLGİ" Style="{StaticResource SectionText}"/>
                                <Button Content="✕" Click="CloseChildInfo_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand" FontSize="13"/>
                            </Grid>
                            <TextBlock Text="{Binding NodeName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>

                            <TextBlock Text="{Binding EmptyStateMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding HasContent, Converter={StaticResource InverseBoolToVis}}"/>
                            <StackPanel Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}">
                                <StackPanel Visibility="{Binding ScreenName, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="Ekran adı" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,10,0,2"/>
                                    <TextBlock Text="{Binding ScreenName}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding BatchName, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="Batch adı" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,10,0,2"/>
                                    <TextBlock Text="{Binding BatchName}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShortDescription, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="Kısa açıklama" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,10,0,2"/>
                                    <TextBlock Text="{Binding ShortDescription}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Alt bilgi: son güncelleme -->
                            <Border Visibility="{Binding HasMeta, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0" Padding="0,10,0,0"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                                <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap">
                                    <Run Text="Son güncelleme: "/><Run Text="{Binding LastUpdate, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding UpdatedBy, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>

                            <!-- Bilgileri Düzenle (yapısal "Ağacı Düzenle" moduna bağlı değil) -->
                            <Button Content="Bilgileri Düzenle" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Command="{Binding DataContext.EditChildDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>

                        <!-- ===== DÜZENLEME FORMU (düzenleme açıkken) ===== -->
                        <StackPanel DataContext="{Binding ChildDetailEdit}"
                                    Visibility="{Binding DataContext.IsEditingChildDetails, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="BİLGİLERİ DÜZENLE" Style="{StaticResource SectionText}"/>
                            <TextBlock Text="{Binding NodeName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <TextBlock Text="Ekran adı" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding ScreenName, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding ScreenNameMax}"/>
                            <TextBlock Text="Batch adı" Style="{StaticResource MutedText}" Margin="0,10,0,2"/>
                            <TextBox Text="{Binding BatchName, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding BatchNameMax}"/>
                            <TextBlock Text="Kısa açıklama" Style="{StaticResource MutedText}" Margin="0,10,0,2"/>
                            <TextBox Text="{Binding ShortDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding ShortDescriptionMax}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="180" VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="{Binding Feedback}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                                       Visibility="{Binding Feedback, Converter={StaticResource StringToVis}}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                                <Button Content="Vazgeç" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
